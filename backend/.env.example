NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://rollcall:rollcall@localhost:5432/rollcall_plus?schema=public

JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

FRONTEND_URL=http://localhost:3000

LOW_ATTENDANCE_THRESHOLD=75
ACCOUNT_LOCK_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Only used when NODE_ENV=production — protects /api/docs with basic auth.
# If either is unset in production, Swagger is disabled entirely rather than
# left open. Not needed for local development (docs stay open on localhost).
SWAGGER_USER=
SWAGGER_PASSWORD=
